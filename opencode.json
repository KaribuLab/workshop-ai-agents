{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "conector-archivos": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/config/workshop"
      ]
    },
    "conector-base-datos": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:WORKSHOP_DATABASE_URL}"
      ]
    }
  }
}
